# =====================================================================
# GymFitness App — Variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commite o .env.local.
# =====================================================================

# --- Supabase (dashboard.supabase.com -> Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_DB_HOST=db.SEU_PROJETO.supabase.co
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=sua_senha_aqui

# Anon key (pública, segura no browser; governada por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Service role key (SERVIDOR APENAS — NUNCA no browser/navegador)
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# --- OmniRoute (IA — https://omniroute.com) ---
OMNIRoute_API_KEY=sua_chave_omniroute

# --- Stripe (pagamentos) ---
STRIPE_SECRET_KEY=sk_sua_chave_aqui
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_sua_chave_aqui
STRIPE_WEBHOOK_SECRET=whsec_seu_webhook_aqui

# --- App URL (usada em emails, magic links, PWA) ---
# LP: gymfitnesscampos.com.br (Lovable)
# App: gymfitnesscampos.com.br/app (Next.js com basePath)
NEXT_PUBLIC_APP_URL=https://gymfitnesscampos.com.br/app

# --- n8n (automações) ---
N8N_BASE_URL=https://seu-n8n.com
N8N_API_KEY=sua_chave_n8n

# --- Modo demo (teste de telas sem login) ---
NEXT_PUBLIC_DEMO_MODE=0

# --- OpenAI / IA (OpenRouter) ---
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=auto/best-fast
OPENAI_MODELS=minimax/minimax-m3:free,nvidia/nemotron-3.5-lightning:free,z-ai/glm-5.2:free,google/gemma-4-31b-it:free

# --- Assistente IA ---
AI_API_URL=https://sua-api-ia.com/v1
AI_API_KEY=sua_chave_ai_aqui
AI_MODEL=testev1
AI_MODEL_FALLBACKS=combofree,auto/best-free
