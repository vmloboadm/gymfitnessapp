# =====================================================================
# GymFitness App — Variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commite o .env.local.
# =====================================================================

# --- Supabase (dashboard.supabase.com -> Settings -> API) ---
# URL do projeto Supabase (ex: https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url

# Anon key (pública, segura no browser; governada por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key (SERVIDOR APENAS — NUNCA no browser/navegador)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- OmniRoute (IA — https://omniroute.com) ---
# Chave própria do produto. Todas as chamadas de IA passam por src/lib/ai/omniroute.ts
OMNIRoute_API_KEY=your_omniroute_api_key

# --- Stripe (pagamentos) ---
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# --- App URL (usada em emails, magic links, PWA) ---
NEXT_PUBLIC_APP_URL=https://app.stackgym.fit

# --- n8n (automações) ---
N8N_BASE_URL=your_n8n_url
N8N_API_KEY=your_n8n_api_key